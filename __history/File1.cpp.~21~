#include <iostream>
#include "IRClientTCP.h"
#include <windows.h>
using namespace std;

main()
{
	IRClientTCP mon_Client;
	unsigned char trame[512];
	int pan;
	int tilt;

	while (true)
	{
		 cout<<"Saisir une valeur de rotation panoramique: ";
		 cin>>pan;
		 cout<<"Saisir une valeur de rotation verticale : ";
		 cin>>tilt;
		 cout<<"Votre valeur est bien envoyee !"<<endl;
		 trame[0]=pan, tilt;
		 mon_Client.SeConnecterAUnServeur("172.20.21.14", 4123);
		 Sleep(1000);
		 mon_Client.Envoyer((char*)trame,512);

	}

}